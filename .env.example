# ---------------------------------------------------------------- frontend --
# Browser-visible. The anon key is safe here; never put the service-role key
# in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_SUPABASE_BUCKET=lead_documents

# ------------------------------------------------------- EXPA sync (server) --
# Used only by scripts/sync-expa.mjs. Keep these out of the browser bundle and
# out of git - in production they live in GitHub Actions secrets.
EXPA_ACCESS_TOKEN=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AIESEC in India MC office id (verified against EXPA; 1518 is Maribor, not India)
EXPA_HOME_MC=1585
# Programme ids: 7 = GV, 8 = GTa, 9 = GTe
EXPA_PROGRAMMES=8,9
SUPABASE_BUCKET=lead_documents
